                  "pm.test('Order delivered', () => pm.expect(pm.response.json().order.status).to.eql('delivered'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Order Withdrawal",
      "item": [
        {
          "name": "5.1 Submit Order (to withdraw)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{enduserToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originLat\": 25.0,\n  \"originLng\": 47.0,\n  \"destLat\": 22.0,\n  \"destLng\": 40.0\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.environment.set('orderId', res.id);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Withdraw Order",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enduserToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Order withdrawn', () => pm.expect(pm.response.json().status).to.eql('withdrawn'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Admin Operations",
      "item": [
        {
          "name": "6.1 List All Orders (paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has data array', () => pm.expect(res.data).to.be.an('array'));",
                  "pm.test('Has meta', () => pm.expect(res.meta).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 Filter Orders by Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders?status=delivered",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"],
              "query": [
                { "key": "status", "value": "delivered" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 List All Drones",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/drones", "host": ["{{baseUrl}}"], "path": ["admin", "drones"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6.4 Update Order Location",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destLat\": 23.5,\n  \"destLng\": 41.0\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/orders/{{orderId}}/location", "host": ["{{baseUrl}}"], "path": ["admin", "orders", "{{orderId}}", "location"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Note: Will return 400 if order is delivered/withdrawn.",
                  "// Submit a new pending order first if needed.",
                  "pm.test('Status is 200 or 400', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.5 Admin: Mark Drone Fixed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"fixed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/drones/{{droneAlphaId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "drones", "{{droneAlphaId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Drone is idle', () => pm.expect(pm.response.json().drone.status).to.eql('idle'));"
                ]
              }
            }
          ]
        }
      ]
    },
