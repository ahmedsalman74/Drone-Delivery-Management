  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Signup (Enduser)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"Alice\",\n  \"type\": \"enduser\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.environment.set('enduserToken', res.accessToken);",
                  "}",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns accessToken', () => pm.expect(res.accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
