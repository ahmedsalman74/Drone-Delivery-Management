{
  "info": {
    "name": "Drone Delivery Management API",
    "description": "Complete API collection for the Drone Delivery Management system.\n\nRun requests IN ORDER from top to bottom to test the full delivery lifecycle.\n\nTokens and IDs are auto-saved to environment variables via test scripts.",
